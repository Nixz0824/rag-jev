        "beam_used": false,
        "slots": {"subject": "格雷福斯", "ability": "Q", "patch": "26.17"},
        "abilities": [
          {"value": "Q", "probability": 0.92},
          {"value": "E", "probability": 0.05},
          {"value": "W", "probability": 0.03}
